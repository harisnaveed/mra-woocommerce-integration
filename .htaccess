# Apache 2.2 and 2.4 Access Control for MRA-WooCommerce Integration Bridge

# Disable directory listing
Options -Indexes

# Protect sensitive environment and configuration files
<FilesMatch "^\.env|^\.git|composer\.(json|lock)$|\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to internal directories
RedirectMatch 403 ^.*/(logs|database)/.*$
