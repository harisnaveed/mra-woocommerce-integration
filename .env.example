# ==============================================================================
# MRA -> WooCommerce Bridge Configuration
# Copy this file to .env and configure your environment-specific credentials.
# ==============================================================================

# Environment (development | production)
APP_ENV=development

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=techrestore_ecommerce
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# MyRepairApp (MRA) API Settings
MRA_API_BASE_URL=https://www.myrepairapp.com/api
MRA_API_KEY=your_mra_api_key_here
MRA_STORE_ID=

# WooCommerce REST API Settings
WC_API_BASE_URL=http://localhost/wp-json/wc/v3
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here
WC_VERIFY_SSL=false

# Sync Engine Settings
SYNC_PAGE_SIZE=50
SYNC_TIMEOUT=30
SYNC_MAX_RETRIES=3

# Webhook Settings
WEBHOOK_SECRET=your_long_random_webhook_secret_here

# Cron Security Settings (Required for browser execution in production)
CRON_SECRET=your_long_random_cron_secret_here

# Safety Guard: STRICT READ-ONLY MODE (Defaults to false. Set to false to prevent accidental stock changes on live MRA)
MRA_ALLOW_WRITES=false

# Logging Settings (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
LOG_FILE=logs/sync.log

